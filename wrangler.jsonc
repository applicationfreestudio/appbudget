{
  // App Budget : application statique (public/) + API de stockage (worker/) sur Cloudflare Workers
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "appbudget",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "appbudget-files" }
  ],
  "observability": { "enabled": true }
}
